# Kept in step with .containerignore. Both are needed: podman reads
# .containerignore, docker reads only .dockerignore, and without this file a
# `docker build` ships the whole working tree -- including any downloaded
# scenes under in/ -- into the context and then bakes it into the image via
# the Containerfile's `COPY . .`.
**/.git
**/.venv
**/.pixi
**/__pycache__
**/local
.claude
.gitignore
.DS_Store
emit-sds-l2b
emit-utils
tetrapy/configs/
*.sh

# Local scratch: input scenes, run outputs and logs. These are large, are never
# needed at build time, and are exactly what inflates an image built from a
# working tree that has been used.
in/
out/
_e2e*
_nodata*
*.log
*.png

# Repository furniture with no role in the build.
.devcontainer/
.github/
.pytest_cache/

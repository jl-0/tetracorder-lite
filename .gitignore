# Ignore filetypes with these suffixes
*.pyc
*.swp

# Ignore files with these names
.DS_Store
.idea
.buildinfo
.nojekyll

# Ignore folders and their contents with these names
.vscode

# Ignore test, build and distribution files
build/
dist/*.whl
*.egg
*.egg-info/
.pytest_cache/
__pycache__/

# Ignore built documentation files
site/
.cache/

# Ignore local testing directories
local/

# Unconvolved master spectral libraries (splib06b / sprlb06b) are small (~24 MB
# total) and are now COMMITTED under tetracorder/sl1/usgs/library06.conv/ so they
# bake into the container image. At runtime only the convolution recipe (.cmds/.csv)
# and the L2A scene (for the target grid) need to be supplied. See
# docs/convolved-library-build.md (volume contract).
# (Legacy copies under rlib06/ remain ignored.)
tetracorder/sl1/usgs/rlib06/sprlb06a
tetracorder/sl1/usgs/rlib06/sprlb06b

# uv
#uv.lock
#.python-version
.venv

# pixi environments
.pixi/*
!.pixi/config.toml

# Repos
emit-sds-l2b
emit-utils

# Generated files
tetracorder/tetracorder.cmds/tetracorder6.00a.cmds/**/*tetrapy*
tetracorder/sl1/usgs/tetrapy
reslib
reflib

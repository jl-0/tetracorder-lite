# Ignore filetypes with these suffixes
*.pyc
*.swp

# Ignore files with these names
.sync.json
.rsync.json
.git
.DS_Store
.idea
.buildinfo
.nojekyll
build_image.sh

# Ignore folders and their contents with these names
# .vscode/* rather than .vscode: git cannot re-include a file whose parent
# directory is excluded, so the bare name made the negation below impossible.
# Personal editor state stays ignored; the demo's checked-in task does not.
.vscode/*
!.vscode/tasks.json

# Ignore test, build and distribution files
build/
# ...but not inside vendored third-party source. libtiff, bundled inside
# iomedley, has a real build/ directory listed in its own SUBDIRS, so the rule
# above silently dropped three tracked files and left a checkout that fails with
# "cd: build: No such file or directory" -- while a local `docker build` passed,
# because the build context is not filtered by .gitignore. Same trap as
# .devcontainer/build/, which is why demo-assets.yml exists.
!vendor/**/build/
!vendor/**/build/**
dist/*.whl
*.egg
*.egg-info/
.pytest_cache/
__pycache__/

# Ignore built documentation files
site/
.cache/

# Ignore local testing directories
local/
configs/
.claude/

# uv
#uv.lock
#.python-version
.venv

# pixi environments
.pixi/*
!.pixi/config.toml

# Repos
emit-sds-l2b
emit-utils

# Generated files
tetracorder/tetracorder.cmds/tetracorder6.00a.cmds/**/*tetrapy*
tetracorder/sl1/usgs/tetrapy
reslib
reflib

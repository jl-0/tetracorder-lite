#!/bin/sh

if [ -z "$1" ]
then
        echo "Usage:"
        echo "./cmds.geology/cmd.list.geologic.classification   class_name"
        echo " "
        echo "./cmds.geology/cmd.list.geologic.classification   list   # lists all names"
fi

lfile="AAA.info/material-classifications.txt"

if [ "$1" = "list" ]
then
        cat $lfile | sed -e 's/^..................................//' | \
                sed -e 's/...................  group= /zzzzzzz              group= /' | \
                grep -a -v DISABLE | grep -a -v '^zero ' | \
                awk '{ printf("%20s   %s\n", $1, $12 ) }' | grep -a -v  'zzzzzzz'

else

        cat $lfile | sed -e 's/^..................................//' | \
                sed -e 's/...................  group= /zzzzzzz              group= /' | \
                grep -a $1 | \
                grep -a -v DISABLE | grep -a -v '^zero ' | \
                awk '{ printf("%20s   %s\n", $1, $12 ) }'
fi
